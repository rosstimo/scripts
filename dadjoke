#!/usr/bin/env bash

# dadjoke
# Fetches a dad joke, saves it to an archive, then displays it.
# If the internet/API/curl fails, it displays a random joke from the archive.
#
# Optional display helpers:
#   cowsay  - puts the joke in a cow speech bubble
#   lolcat  - makes the output colorful
#
# Suggested installs:
#
#   Arch / Manjaro:
#     sudo pacman -S cowsay lolcat
#
#   Debian / Ubuntu:
#     sudo apt install cowsay lolcat
#
#   Fedora:
#     sudo dnf install cowsay rubygem-lolcat

set -u

ARCHIVE_DIR="$HOME/Documents/joke-archive"
ARCHIVE_FILE="$ARCHIVE_DIR/dad-jokes.txt"

show_usage() {
    cat <<'EOF'
Usage:
  dadjoke [option]

Options:
  -h, --help      Show this help message

Description:
  Fetches a dad joke from https://icanhazdadjoke.com/
  Saves it to ~/Documents/joke-archive/dad-jokes.txt
  Displays it in the terminal.

Fallback behavior:
  If the internet is down, curl fails, or the joke API is unavailable,
  dadjoke will display a random joke from the local archive instead.

Optional programs:
  cowsay          Display the joke in a speech bubble
  lolcat          Add rainbow coloring to the output

Suggested installs:

  Arch / Manjaro:
    sudo pacman -S cowsay lolcat

  Debian / Ubuntu:
    sudo apt install cowsay lolcat

  Fedora:
    sudo dnf install cowsay rubygem-lolcat

Examples:
  dadjoke
  dadjoke --help
EOF
}

get_random_archived_joke() {
    if [[ ! -s "$ARCHIVE_FILE" ]]; then
        return 1
    fi

    awk '
        /^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] / {
            getline
            if ($0 != "") {
                jokes[++count] = $0
            }
        }

        END {
            if (count > 0) {
                srand()
                print jokes[int(rand() * count) + 1]
            } else {
                exit 1
            }
        }
    ' "$ARCHIVE_FILE"
}

display_joke() {
    local joke="$1"
    local output

    output="$joke"

    if command -v cowsay >/dev/null 2>&1; then
        output="$(printf '%s\n' "$output" | cowsay)"
    fi

    if command -v lolcat >/dev/null 2>&1; then
        printf '%s\n' "$output" | lolcat
    else
        printf '%s\n' "$output"
    fi
}

case "${1:-}" in
    -h|--help)
        show_usage
        exit 0
        ;;
    "")
        ;;
    *)
        printf 'Unknown option: %s\n\n' "$1" >&2
        show_usage
        exit 1
        ;;
esac

mkdir -p "$ARCHIVE_DIR"

joke="$(
    curl \
        --silent \
        --fail \
        --connect-timeout 2 \
        --max-time 5 \
        -H "Accept: text/plain" \
        https://icanhazdadjoke.com/ 2>/dev/null
)" || joke=""

if [[ -n "${joke:-}" ]]; then
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

    {
        printf '[%s]\n' "$timestamp"
        printf '%s\n\n' "$joke"
    } >> "$ARCHIVE_FILE"

    display_joke "$joke"
    exit 0
fi

archived_joke="$(get_random_archived_joke)" || archived_joke=""

if [[ -n "${archived_joke:-}" ]]; then
    display_joke "$archived_joke"
    exit 0
fi

# No internet and no archive. Truly, the machine has become humorless.
exit 0